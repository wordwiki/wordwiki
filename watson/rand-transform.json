{
 "formatVersion": 1,
 "sources": [
  {
   "table": "randraw"
  }
 ],
 "targetName": "Rand 1888, transcribed and revised by Watson",
 "entryValidFrom": {
  "from": "dt",
  "parser": "shoeboxDate"
 },
 "targetSchema": {
  "$type": "schema",
  "$name": "rand",
  "$tag": "rand",
  "entry": {
   "$type": "relation",
   "$tag": "ent",
   "$prompt": "Entry",
   "$style": {
    "$shape": "containerRelation"
   },
   "entry_id": {
    "$type": "primary_key"
   },
   "spelling": {
    "$type": "relation",
    "$tag": "spl",
    "spelling_id": {
     "$type": "primary_key"
    },
    "text": {
     "$type": "string",
     "$bind": "attr1"
    },
    "variant": {
     "$type": "variant"
    },
    "$style": {
     "$shape": "compactInlineListRelation",
     "$view": {
      "order": 1,
      "titleRole": "headword",
      "join": " / ",
      "label": "inline"
     }
    }
   },
   "subentry": {
    "$type": "relation",
    "$tag": "sub",
    "subentry_id": {
     "$type": "primary_key"
    },
    "part_of_speech": {
     "$type": "string",
     "$bind": "attr1",
     "$optional": true,
     "$style": {
      "$view": {
       "order": 2,
       "label": "inline"
      },
      "$prompt": "Paradigm (Mi'gmewi'suti)"
     }
    },
    "part_of_speech_en": {
     "$type": "string",
     "$bind": "attr2",
     "$optional": true,
     "$style": {
      "$view": {
       "order": 3,
       "label": "inline"
      },
      "$prompt": "Part of speech"
     }
    },
    "$style": {
     "$shape": "containerRelation",
     "$view": {
      "order": 3,
      "singleton": "collapse",
      "numbered": true,
      "empty": "elide"
     }
    },
    "gloss": {
     "$type": "relation",
     "$tag": "gls",
     "gloss_id": {
      "$type": "primary_key"
     },
     "gloss": {
      "$type": "string",
      "$bind": "attr1"
     },
     "$style": {
      "$shape": "inlineListRelation",
      "$view": {
       "order": 4,
       "titleRole": "gloss",
       "label": "inline"
      }
     }
    },
    "literal_translation": {
     "$type": "relation",
     "$tag": "lit",
     "$prompt": "Literal translation",
     "literal_translation_id": {
      "$type": "primary_key"
     },
     "$style": {
      "$shape": "inlineListRelation",
      "$view": {
       "order": 5,
       "label": "inline",
       "empty": "elide"
      }
     },
     "literal_translation": {
      "$type": "string",
      "$bind": "attr1"
     }
    },
    "example": {
     "$type": "relation",
     "$tag": "exa",
     "$prompt": "Examples",
     "example_id": {
      "$type": "primary_key"
     },
     "$style": {
      "$shape": "containerRelation",
      "$view": {
       "order": 6,
       "label": "heading",
       "singleton": "list",
       "empty": "elide"
      }
     },
     "example_text": {
      "$type": "relation",
      "$tag": "etx",
      "$prompt": "Text",
      "example_text_id": {
       "$type": "primary_key"
      },
      "variant": {
       "$type": "variant",
       "$mixed": true,
       "$sourceOrthography": true
      },
      "$style": {
       "$shape": "compactInlineListRelation",
       "$view": {
        "order": 1,
        "label": "inline",
        "empty": "elide"
       }
      },
      "example_text": {
       "$type": "string",
       "$bind": "attr1"
      }
     },
     "example_translation": {
      "$type": "relation",
      "$tag": "etr",
      "$prompt": "Translation",
      "example_translation_id": {
       "$type": "primary_key"
      },
      "$style": {
       "$shape": "compactInlineListRelation",
       "$view": {
        "order": 2,
        "label": "inline",
        "empty": "elide",
        "emphasis": "italic"
       }
      },
      "example_translation": {
       "$type": "string",
       "$bind": "attr1"
      }
     }
    }
   },
   "variant_form": {
    "$type": "relation",
    "$tag": "vaf",
    "$prompt": "Variant form",
    "variant_form_id": {
     "$type": "primary_key"
    },
    "$style": {
     "$shape": "inlineListRelation",
     "$view": {
      "order": 8,
      "label": "inline",
      "empty": "elide"
     }
    },
    "variant_form_text": {
     "$type": "string",
     "$bind": "attr1"
    }
   },
   "source": {
    "$type": "relation",
    "$tag": "src",
    "$prompt": "Source",
    "source_id": {
     "$type": "primary_key"
    },
    "source": {
     "$type": "string",
     "$bind": "attr1"
    },
    "book": {
     "$type": "string",
     "$bind": "attr2",
     "$optional": true
    },
    "page": {
     "$type": "integer",
     "$bind": "attr3",
     "$optional": true
    },
    "$style": {
     "$shape": "inlineListRelation",
     "$view": {
      "order": 9,
      "label": "inline",
      "empty": "elide",
      "compose": [
       "source"
      ],
      "sep": " "
     }
    }
   },
   "note": {
    "$type": "relation",
    "$tag": "nte",
    "note_id": {
     "$type": "primary_key"
    },
    "note": {
     "$type": "string",
     "$bind": "attr1",
     "$style": {
      "$width": 80,
      "$height": 5,
      "$markdown": true
     }
    },
    "$style": {
     "$shape": "compactInlineListRelation",
     "$view": {
      "order": 10,
      "label": "inline",
      "empty": "elide"
     }
    }
   },
   "pronunciation_guide": {
    "$type": "relation",
    "$tag": "prn",
    "pronunciation_id": {
     "$type": "primary_key"
    },
    "$style": {
     "$shape": "compactInlineListRelation",
     "$view": {
      "order": 7,
      "label": "inline",
      "empty": "elide"
     }
    },
    "pronunciation_guide": {
     "$type": "string",
     "$bind": "attr1"
    }
   },
   "attr": {
    "$type": "relation",
    "$tag": "att",
    "attr_id": {
     "$type": "primary_key"
    },
    "attr": {
     "$type": "string",
     "$bind": "attr1"
    },
    "value": {
     "$type": "string",
     "$bind": "attr2",
     "$optional": true,
     "$style": {
      "$width": 50
     }
    },
    "variant": {
     "$type": "variant",
     "$mixed": true,
     "$allowAll": true,
     "$defaultAll": true
    },
    "$style": {
     "$shape": "inlineListRelation",
     "$view": {
      "order": 11,
      "keyField": "attr"
     }
    }
   },
   "document_reference": {
    "$type": "relation",
    "$tag": "ref",
    "$role": "documentReference",
    "$style": {
     "$shape": "containerRelation",
     "$view": {
      "order": 12,
      "label": "heading",
      "empty": "elide"
     }
    },
    "document_reference_id": {
     "$type": "primary_key",
     "$bind": "id"
    },
    "bounding_group_id": {
     "$type": "integer",
     "$bind": "attr1",
     "$style": {
      "$shape": "boundingGroup"
     }
    },
    "transcription": {
     "$type": "relation",
     "$tag": "rtr",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 1,
       "label": "inline",
       "empty": "elide"
      }
     },
     "transcription_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "transcription": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5
      }
     }
    },
    "expanded_transcription": {
     "$type": "relation",
     "$tag": "rex",
     "$prompt": "Expanded",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 2,
       "label": "inline",
       "empty": "elide"
      }
     },
     "expanded_transcription_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "expanded_transcription": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5
      }
     }
    },
    "transliteration": {
     "$type": "relation",
     "$tag": "rtl",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 3,
       "label": "inline",
       "empty": "elide"
      }
     },
     "transliteration_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "transliteration": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5
      }
     },
     "variant": {
      "$type": "variant",
      "$bind": "variant",
      "$mixed": true,
      "$sourceOrthography": true
     }
    },
    "source_as_entry": {
     "$type": "relation",
     "$tag": "rse",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 4,
       "label": "inline",
       "empty": "elide",
       "emptyEdit": "menu"
      }
     },
     "source_as_entry_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "source_as_entry": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5
      }
     },
     "variant": {
      "$type": "variant",
      "$bind": "variant",
      "$mixed": true,
      "$sourceOrthography": true
     }
    },
    "normalized_source_as_entry": {
     "$type": "relation",
     "$tag": "rne",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 5,
       "label": "inline",
       "empty": "elide",
       "emptyEdit": "menu"
      }
     },
     "normalized_source_as_entry_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "normalized_source_as_entry": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5
      }
     },
     "variant": {
      "$type": "variant",
      "$bind": "variant",
      "$mixed": true,
      "$sourceOrthography": true
     }
    },
    "foreign_reference": {
     "$type": "relation",
     "$tag": "rfr",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 6,
       "label": "inline",
       "empty": "elide",
       "emptyEdit": "menu"
      }
     },
     "foreign_reference_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "foreign_reference": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60
      }
     },
     "variant": {
      "$type": "variant",
      "$bind": "variant",
      "$mixed": true,
      "$sourceOrthography": true
     }
    },
    "note": {
     "$type": "relation",
     "$tag": "rnt",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 7,
       "label": "inline",
       "empty": "elide",
       "audience": "internal"
      }
     },
     "note_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "note": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5,
       "$markdown": true
      }
     }
    },
    "public_note": {
     "$type": "relation",
     "$tag": "rnp",
     "$prompt": "Public note",
     "$style": {
      "$shape": "compactInlineListRelation",
      "$view": {
       "order": 8,
       "label": "inline",
       "empty": "elide",
       "emptyEdit": "menu"
      }
     },
     "public_note_id": {
      "$type": "primary_key",
      "$bind": "id"
     },
     "public_note": {
      "$type": "string",
      "$bind": "attr1",
      "$style": {
       "$width": 60,
       "$height": 5,
       "$markdown": true
      }
     },
     "variant": {
      "$type": "variant",
      "$bind": "variant",
      "$mixed": true,
      "$allowAll": true,
      "$defaultAll": true
     }
    }
   }
  }
 },
 "rules": [
  {
   "from": "lx",
   "to": "spelling",
   "set": {
    "text": {
     "content": true
    },
    "variant": {
     "const": "watson-li"
    }
   }
  },
  {
   "from": "lsf",
   "to": "spelling",
   "set": {
    "text": {
     "content": true
    },
    "variant": {
     "const": "watson-sf"
    }
   }
  },
  {
   "from": "ph",
   "to": "pronunciation_guide",
   "set": {
    "pronunciation_guide": {
     "content": true
    }
   }
  },
  {
   "from": "ps",
   "to": "subentry",
   "set": {
    "part_of_speech": {
     "content": true
    }
   }
  },
  {
   "from": "ps/pn",
   "intoParentField": "part_of_speech_en",
   "value": {
    "content": true
   }
  },
  {
   "from": "ps/ge",
   "to": "subentry/gloss",
   "set": {
    "gloss": {
     "content": true,
     "replaceAll": {
      "_": " "
     }
    }
   }
  },
  {
   "from": "ps/de",
   "to": "subentry/literal_translation",
   "set": {
    "literal_translation": {
     "content": true,
     "replaceAll": {
      "_": " "
     }
    }
   }
  },
  {
   "from": "ps/xv",
   "to": "subentry/example/example_text",
   "set": {
    "example_text": {
     "content": true
    },
    "variant": {
     "const": "rand"
    }
   }
  },
  {
   "from": "ps/xv/xe",
   "to": "subentry/example/example_translation",
   "set": {
    "example_translation": {
     "content": true
    }
   }
  },
  {
   "from": "so",
   "to": "source",
   "parser": "randCitation",
   "set": {
    "source": {
     "content": true
    },
    "book": {
     "parsed": "book",
     "recode": {
      "Rand 1888": "Rand 1888",
      "Clark 1902": "Clark 1902",
      "RRand 1888": "Rand 1888",
      "RaRand 1888": "Rand 1888",
      "Rand 188": "Rand 1888",
      "Rand": "Rand 1888",
      "Rand1888": "Rand 1888",
      "RanRand 1888": "Rand 1888",
      "Claek 1902": "Clark 1902",
      "Gina'masultiewei Glusuaqann": "Gina'masultiewei Glusuaqann"
     },
     "recodeMiss": "keep"
    },
    "page": {
     "parsed": "page"
    }
   }
  },
  {
   "from": "nt",
   "to": "note",
   "set": {
    "note": {
     "content": true
    }
   }
  },
  {
   "from": "va",
   "to": "variant_form",
   "set": {
    "variant_form_text": {
     "content": true
    }
   }
  },
  {
   "from": "dt",
   "to": "attr",
   "set": {
    "attr": {
     "const": "shoebox-date"
    },
    "value": {
     "content": true
    },
    "variant": {
     "const": "mm"
    }
   }
  },
  {
   "from": "zpt",
   "to": "attr",
   "set": {
    "attr": {
     "const": "import-partition"
    },
    "value": {
     "content": true
    },
    "variant": {
     "const": "mm"
    }
   }
  },
  {
   "from": "zdv",
   "to": "attr",
   "set": {
    "attr": {
     "const": "merge-divergence"
    },
    "value": {
     "content": true
    },
    "variant": {
     "const": "mm"
    }
   }
  }
 ]
}
